generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Bot template — a reusable recipe (e.g., "ESPN Scoreboard Scraper")
model BotTemplate {
  id            String   @id @default(cuid())
  name          String
  description   String?
  poolType      String // browser | scraper | trading | monitor | mcp_host | ci_agent | task_runner | ai_agent
  configSchema  Json // JSON Schema for params
  defaultConfig Json
  // Phase 5b: optional dispatch-time placement. Shape: { region?: string; zone?: string }.
  // Null = no preference; bots based on this template route to the
  // `hive:pool:<pool>:any:any` stream by default.
  affinity      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bots          Bot[]

  @@index([poolType])
}

// Bot — an instantiated template with concrete params
model Bot {
  id               String         @id @default(cuid())
  templateId       String
  template         BotTemplate    @relation(fields: [templateId], references: [id])
  // userId = null means a shared/admin bot visible only to admins.
  // Set to the owning user's id for user-created bots.
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name             String
  config           Json
  // Phase 5b: overrides template.affinity when set. Same shape: { region?, zone? }.
  // Null = inherit from template.
  affinityOverride Json?
  enabled          Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  jobs             Job[]
  schedules        Schedule[]
  alerts           Alert[]
  missionAgents    MissionAgent[]

  @@index([templateId])
  @@index([userId])
}

// Job — a single execution of a bot
model Job {
  id          String    @id @default(cuid())
  botId       String
  bot         Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  status      String // queued | running | succeeded | failed | cancelled
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  payload     Json
  result      Json?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  logs        JobLog[]

  @@index([status])
  @@index([botId])
  @@index([createdAt])
}

model JobLog {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     String // debug | info | warn | error
  message   String
  meta      Json?
  timestamp DateTime @default(now())

  @@index([jobId, timestamp])
}

model Schedule {
  id        String    @id @default(cuid())
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  cron      String // cron expression
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?
  createdAt DateTime  @default(now())

  @@index([nextRunAt, enabled])
}

model Worker {
  id         String   @id @default(cuid())
  poolType   String
  hostname   String
  // Phase 5b: self-declared location for affinity-based routing. Single-host
  // setups leave these at the defaults and everything keeps working.
  region     String   @default("local")
  zone       String   @default("default")
  status     String // online | offline | draining
  capacity   Int      @default(1)
  activeJobs Int      @default(0)
  lastSeenAt DateTime @default(now())
  metadata   Json?

  @@index([poolType, status])
  @@index([poolType, region, zone])
}

model AiUsage {
  id           String   @id @default(cuid())
  jobId        String?
  provider     String // claude | gpt | perplexity
  model        String
  inputTokens  Int
  outputTokens Int
  costCents    Int
  createdAt    DateTime @default(now())

  @@index([provider, createdAt])
}

// ============ Trading (Phase 3b) ============

model PaperWallet {
  id        String   @id @default(cuid())
  exchange  String
  currency  String
  balance   Decimal  @default(0) @db.Decimal(18, 8)
  botId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([exchange, currency])
  @@index([botId])
}

model PaperTrade {
  id            String   @id @default(cuid())
  jobId         String
  exchange      String
  symbol        String
  side          String // buy | sell
  type          String // market | limit
  amount        Decimal  @db.Decimal(18, 8)
  price         Decimal? @db.Decimal(18, 8)
  status        String // filled | cancelled | failed
  executedPrice Decimal? @db.Decimal(18, 8)
  createdAt     DateTime @default(now())

  @@index([jobId])
  @@index([symbol, createdAt])
}

model TradeAudit {
  id        String   @id @default(cuid())
  jobId     String
  botId     String
  mode      String // paper | live
  action    String
  payload   Json
  result    Json
  createdAt DateTime @default(now())

  @@index([botId, createdAt])
  @@index([mode, createdAt])
  @@index([jobId])
}

// ============ Auth (Phase 3c) ============

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  displayName  String
  role         String       @default("user") // admin | user
  createdAt    DateTime     @default(now())
  lastLoginAt  DateTime?
  sessions     Session[]
  resetTokens  ResetToken[]
  auditEntries AuditLog[]
  bots         Bot[]
  alerts       Alert[]
  profile      UserProfile?
  missions     Mission[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

// ============ Password reset (Phase 6b) ============

// Single-use password reset token. We store only the SHA-256 hash of the raw
// token (same pattern as Session.tokenHash) so a DB leak can't be used to reset
// passwords. `usedAt` is set when consumed so a token can't be replayed.
model ResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============ KMS keys (Phase 5a) ============

// Tracks every KEK that has wrapped DEKs in this database. Used by
// `pnpm --filter @hive/api kms:rotate` to find which envelopes to re-wrap.
model KmsKey {
  id        String    @id @default(cuid())
  keyId     String    @unique // provider-specific identifier (e.g., AWS KMS ARN, 'static:v1')
  provider  String // 'static' | 'aws'
  status    String // 'active' | 'retiring' | 'revoked'
  createdAt DateTime  @default(now())
  retiredAt DateTime?

  @@index([status])
}

// ============ Artifacts (Phase 4b) ============

model Artifact {
  id              String   @id @default(cuid())
  jobId           String
  filename        String
  contentType     String
  sizeBytes       Int
  // Provider-internal key (e.g., 'jobId/file.png'). Renamed from `path` in
  // Phase 5a so the abstraction works for S3 as well as local FS.
  storageKey      String
  storageProvider String   @default("local") // 'local' | 's3'
  createdAt       DateTime @default(now())

  @@index([jobId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  payload    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ============ Alerts ============

// Alert rule — notify a user channel when a bot changes health state.
// botId = null means "any of this user's bots".
model Alert {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId         String?
  bot           Bot?      @relation(fields: [botId], references: [id], onDelete: Cascade)
  channel       String // email | slack
  // email channel: { email: string }
  // slack channel: { webhookUrl: string }
  config        Json
  // Which transitions to fire on. Stored as comma-separated string for PG compat.
  // Values: "failed" | "recovered"
  triggerOn     String    @default("failed") // "failed" | "failed,recovered"
  enabled       Boolean   @default(true)
  // Tracks the last job we checked so we don't double-fire.
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([botId])
}

// ============ User profile / onboarding ============

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Which vertical the user selected during onboarding.
  // ecommerce | recruiting | agency | trading
  vertical  String?
  onboarded Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============ Digest history (learning loop) ============

// One row per daily digest run. Stores which bots were failing and what Claude
// recommended so tomorrow's digest can identify recoveries and carry forward
// unresolved recommendations.
model DigestRun {
  id             String   @id @default(cuid())
  // windowEnd is "now" at digest time — unique so upsert works on manual re-runs.
  windowEnd      DateTime @unique
  // JSON array of BotFailSnapshot: { botId, botName, pool, errorSamples, lessonText }
  failingBots    Json
  lessonsLearned String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// ============ Swarm (missions / blackboard / proposals) ============

// A mission composes existing Bots into roles that build on each other's
// output. Domain-agnostic: the trading desk is one mission config, competitor
// monitoring and repo triage are others. Same machine, different gatherers.
//
// Status/role values are plain strings with documented domains, matching the
// convention used by Job.status, Worker.status and Alert.channel above.
model Mission {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  domain         String // free text: 'trading' | 'recruiting' | 'racing' | ...
  objective      String
  status         String    @default("draft") // draft | running | paused | stopped
  // Constraint limits keyed by rule name, read by @hive/swarm evaluate().
  // e.g. { "mission:actions": 40, "min_independent_sources": 2 }
  limits         Json      @default("{}")
  // Executor verbs this mission is allowed to propose. Start every new mission
  // at ["notify"] and widen only once the digest shows it calling things right.
  allowedActions String[]  @default([])
  // manual = every proposal waits for a human.
  // auto_below_threshold = low-stakes actions self-approve (see Proposal).
  approvalMode   String    @default("manual")
  lastDecisionAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  agents     MissionAgent[]
  findings   Finding[]
  hypotheses Hypothesis[]
  proposals  Proposal[]

  @@index([userId, status])
  @@index([status])
}

// Binds one existing Bot into a mission under a role. The same bot can appear
// in several missions, and in more than one role within a mission.
model MissionAgent {
  id         String    @id @default(cuid())
  missionId  String
  mission    Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  botId      String
  bot        Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  // gatherer | extractor | analyst | adversary | constraint | coordinator | executor
  role       String
  // Which board event kinds this agent consumes. Empty for gatherers, which
  // are driven by their Schedule rather than by the board.
  subscribes String[]  @default([])
  // For gatherers only: the single upstream source this agent owns. One
  // gatherer per source is a hard rule — it's what makes dedup possible.
  sourceId   String?
  enabled    Boolean   @default(true)
  // Rolling liveness, mirrored onto the terminal's swarm field.
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([missionId, botId, role])
  @@index([missionId, role])
}

model Finding {
  id          String   @id @default(cuid())
  missionId   String
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  agentId     String
  kind        String // mission-defined: 'price' | 'headline' | 'commit' | ...
  payload     Json
  sourceId    String
  sourceKind  String
  observedAt  DateTime
  fetchedAt   DateTime
  contentHash String   @db.Char(64)
  jobId       String
  createdAt   DateTime @default(now())

  // The dedup key. Same source + same bytes = one signal, however many agents
  // saw it. Enforced here so a buggy extractor can't inflate consensus.
  @@unique([missionId, sourceId, contentHash])
  @@index([missionId, kind, observedAt])
}

model Hypothesis {
  id                   String   @id @default(cuid())
  missionId            String
  mission              Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  agentId              String
  claim                String
  confidence           Float
  supportingFindingIds String[]
  // Distinct sources behind the claim, set by the dedup pass. Ranking uses
  // this and never the number of agents that agree.
  independentSources   Int      @default(0)
  createdAt            DateTime @default(now())

  challenges Challenge[]

  @@index([missionId, createdAt])
  @@index([missionId, independentSources])
}

model Challenge {
  id           String     @id @default(cuid())
  hypothesisId String
  hypothesis   Hypothesis @relation(fields: [hypothesisId], references: [id], onDelete: Cascade)
  agentId      String
  objection    String
  severity     String // note | weakens | refutes
  createdAt    DateTime   @default(now())

  @@index([hypothesisId])
}

model Proposal {
  id                String    @id @default(cuid())
  missionId         String
  mission           Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  action            String
  params            Json
  rationale         String
  status            String    @default("pending") // pending | approved | rejected | expired | executed | failed
  // Array of { rule, passed, detail } from @hive/swarm evaluate().
  constraintResults Json      @default("[]")
  // Hard TTL. An approval arriving after this is refused server-side — a stale
  // approval acts on a world state that no longer exists.
  expiresAt         DateTime
  decidedById       String?
  decidedAt         DateTime?
  executedJobId     String?
  error             String?
  createdAt         DateTime  @default(now())

  @@index([missionId, status, expiresAt])
  @@index([status, expiresAt])
}
